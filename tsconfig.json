{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "ES2022.Error"],
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.ts", "src/**/*"],
  "exclude": ["**/*.spec.ts"]
}
